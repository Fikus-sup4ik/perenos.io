{
  "name": "lampa-history-transfer-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker + D1 backend for Lampa History Transfer",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute lampa-history-transfer --local --file=./database.sql",
    "db:init:remote": "wrangler d1 execute lampa-history-transfer --remote --file=./database.sql",
    "test": "node --test ../tests/*.test.js"
  },
  "keywords": [
    "lampa",
    "cub",
    "cloudflare-workers",
    "d1",
    "backup"
  ],
  "license": "MIT"
}
